{
	"name": "astro-themes",
	"version": "0.2.0",
	"description": "Perfect dark mode in Astro with no flash. System preference, multiple themes, and sync across tabs.",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"default": "./src/index.js"
		},
		"./components": {
			"types": "./src/components/index.d.ts",
			"default": "./src/components/index.js"
		},
		"./components/ThemeProvider.astro": "./src/components/ThemeProvider.astro",
		"./client": {
			"types": "./src/client.d.ts",
			"default": "./src/client.js"
		},
		"./types": {
			"types": "./src/types.d.ts",
			"default": "./src/types.js"
		},
		"./toolbar": {
			"types": "./src/toolbar/app.d.ts",
			"default": "./src/toolbar/app.js"
		}
	},
	"keywords": [
		"astro-integration",
		"astro-component",
		"withastro",
		"astro",
		"dark-mode",
		"themes",
		"theme-provider",
		"next-themes"
	],
	"author": "",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gravures/astro-themes.git"
	},
	"bugs": "https://github.com/gravures/astro-themes/issues",
	"homepage": "https://github.com/gravures/astro-themes#readme",
	"license": "MIT",
	"peerDependencies": {
		"astro": "^5.1.3 || ^6.0.0 || ^7.0.0"
	},
	"dependencies": {
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@types/node": "^25.0.8"
	}
}
